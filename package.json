{
  "name": "shotkit",
  "productName": "ShotKit",
  "version": "0.4.0",
  "description": "A CleanShot X-style screenshot tool for Windows",
  "author": "Patrick Kuijpers",
  "homepage": "https://github.com/PK-Trades/shotkit",
  "repository": {
    "type": "git",
    "url": "https://github.com/PK-Trades/shotkit.git"
  },
  "main": "dist/main.js",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "start": "node build.mjs && electron .",
    "dist": "node scripts/make-icon.mjs && node build.mjs && electron-builder --win nsis --publish never",
    "release": "node scripts/make-icon.mjs && node build.mjs && electron-builder --win nsis --publish always",
    "test": "node scripts/test.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "koffi": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "^37.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0"
  },
  "build": {
    "appId": "com.shotkit.app",
    "productName": "ShotKit",
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "PK-Trades",
      "repo": "shotkit",
      "releaseType": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/koffi/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ShotKit",
      "runAfterFinish": true,
      "artifactName": "ShotKit-Setup-${version}.${ext}"
    }
  },
  "allowScripts": {
    "electron@37.10.3": true,
    "esbuild@0.25.12": true,
    "koffi@2.16.3": true
  }
}
